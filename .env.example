# Copiez ce fichier en .env (jamais commité) et remplissez-le.
# Clé API Coinbase (CDP) : droits "View" + "Trade" uniquement, JAMAIS "Transfer".
COINBASE_API_KEY=organizations/xxx/apiKeys/xxx
COINBASE_API_SECRET="-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----\n"
# Obligatoire pour autoriser le mode réel
BOT_CONFIRM_LIVE=non
# Alertes Telegram (facultatif)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
